# 0: 모델 없이 더미 응답(연동 확인용), 1: Whisper·YAMNet 적재
AI_LOAD_MODELS=0
# faster-whisper 모델 크기 (tiny / base / small)
AI_WHISPER_MODEL=base
# YAMNet 위험 클래스 임계값 (SDS FD-015 초기값)
AI_YAMNET_THRESHOLD=0.3
# /analyze/pcm 기본 샘플레이트 (워치: 16kHz mono 16bit)
AI_PCM_SAMPLE_RATE=16000
# 설정하면 /analyze 호출에 X-API-Key 헤더 필요 (백엔드만 호출, NFR-SEC-03)
AI_API_KEY=

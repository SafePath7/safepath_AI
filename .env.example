# 0: 모델 없이 더미 응답(연동 확인용), 1: Whisper·YAMNet·ECAPA(화자) 적재
AI_LOAD_MODELS=0
# faster-whisper 모델 크기 (tiny / base / small)
AI_WHISPER_MODEL=base
# 음성 위험 판정 임계값 (FD-014, 위험 문구 점수 0~1)
AI_VOICE_THRESHOLD=0.5
# 무음 판정 음량(dBFS). 이보다 작으면 Whisper 분석 생략
AI_SILENCE_DBFS=-50
# Whisper가 위험 문구 쪽으로 받아 적게 유도. 오탐이 늘어 기본 꺼짐 (docs/models 평가 참고)
AI_WHISPER_HOTWORDS=0
# 음성 등록(FD-016) 최소 말소리 길이(초)와 최소 음량(dBFS). 미달이면 재녹음 안내(422)
AI_ENROLL_MIN_SPEECH_SEC=8
AI_ENROLL_MIN_DBFS=-40
# 2단계 '위급할 때 목소리' 녹음(선택)의 최소 말소리 길이(초)
AI_ENROLL_URGENT_MIN_SPEECH_SEC=1.5
# 2단계 녹음 임베딩을 평소 목소리 임베딩과 합쳐 저장 (실제 녹음으로 효과 확인 전까지 0)
AI_ENROLL_MIX_URGENT=0
# YAMNet 위험 클래스 임계값 (SDS FD-015 초기값)
AI_YAMNET_THRESHOLD=0.3
# YAMNet 클립 점수 = 클래스별 상위 k개 프레임 평균 (프레임 간격 0.48초)
AI_YAMNET_TOP_K=2
# 위험 음향 판정: loudness(갑자기 큰 소리, YAMNet은 이름만) / yamnet(예전 방식)
AI_SOUND_MODE=loudness
# 갑자기 큰 소리 (문헌 초안, 워치 녹음으로 재조정): 배경보다 +15dB(+25dB면 1점) 그리고 평소 말소리보다 +16dB
# 평소 말소리 = 음성 프로필 baseline_volume, 프로필이 없으면 아래 값(dBFS)
AI_LOUD_JUMP_DB=15
AI_LOUD_SPAN_DB=10
AI_LOUD_OVER_SPEECH_DB=16
AI_LOUD_SPEECH_REF_DBFS=-22
# 큰 소리에 YAMNet 이름(scream·glass_break 등)을 붙이는 최소 점수
AI_SOUND_LABEL_MIN=0.15
# 종합 위험도 임계값 (SDS FD-018 TBD-5). 0.5면 모델별 임계값과 같은 판정
AI_RISK_THRESHOLD=0.5
# 여러 신호 종합: 이 값 이상인 신호끼리 noisy-OR로 합쳐 동시 발생 시 위험도를 올림
AI_COMBINE_MIN=0.25
# 위험 이벤트를 만든 뒤 이 시간(초) 안의 같은 세션 위험은 같은 이벤트로 묶음 (확인 질문 대기 시간)
AI_EVENT_GROUP_SEC=30
# 위험 이벤트에 함께 올리는 직전 소리(초). 평소에는 세션마다 이만큼만 메모리에 둔다(DB 저장 없음)
AI_EVENT_PREROLL_SEC=10
# 화자 검증: 본인 판정 유사도, 위험도 최대 가산값, 가산을 시작하는 위험도, 검증 최소 말소리(초)
AI_VERIFY_SIM_THRESHOLD=0.4
AI_VERIFY_BOOST_MAX=0.15
AI_VERIFY_BOOST_MIN_BASE=0.3
AI_VERIFY_MIN_SPEECH_SEC=1.0
# 흥분도 1이 되는 폭: 평소 상단보다 피치 비율 +0.3, 음량 +6dB
AI_VERIFY_PITCH_SPAN=0.3
AI_VERIFY_VOLUME_SPAN_DB=6
# 백엔드 연동: 주소, 내부 키(선택, 설정하면 X-Internal-Key 헤더. 개발 중에는 비워 둠). 주소를 비우면 백엔드를 부르지 않음(프로필 조회·위험 이벤트·프로필 저장 생략)
# 폰이 보낸 Authorization(Firebase 토큰)을 그대로 넘긴다. 제한 시간(초): 조회·이벤트 생성 / 녹음·미디어 업로드
AI_BACKEND_URL=
AI_BACKEND_KEY=
AI_BACKEND_TIMEOUT_SEC=3
AI_BACKEND_UPLOAD_TIMEOUT_SEC=10
# 시연용 음성 프로필 JSON 파일. 설정하면 백엔드 대신 모든 세션에 이 프로필을 쓰고 등록 결과도 여기에 저장
AI_DEMO_PROFILE=
# 세션 요청이 이 시간(초) 동안 없으면 받아 둔 프로필을 지움
AI_PROFILE_IDLE_SEC=600
# 모델 가중치 캐시 폴더 (비우면 저장소의 models/, Git 제외)
AI_MODEL_CACHE_DIR=
# /api/ai/analyze/pcm 기본 샘플레이트 (워치: 16kHz mono 16bit)
AI_PCM_SAMPLE_RATE=16000
# 요청 본문 최대 크기(MB). 넘으면 413 (백엔드 미디어 업로드 제한과 동일)
AI_MAX_UPLOAD_MB=10
# 설정하면 /api/ai/** 호출에 X-API-Key 헤더 필요 (개발용 고정 키)
AI_API_KEY=

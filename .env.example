# 0: 모델 없이 더미 응답(연동 확인용), 1: Whisper·YAMNet 적재
AI_LOAD_MODELS=0
# faster-whisper 모델 크기 (tiny / base / small)
AI_WHISPER_MODEL=base
# 음성 위험 판정 임계값 (FD-014, 위험 문구 점수 0~1)
AI_VOICE_THRESHOLD=0.5
# 무음 판정 음량(dBFS). 이보다 작으면 Whisper 분석 생략
AI_SILENCE_DBFS=-50
# Whisper가 위험 문구 쪽으로 받아 적게 유도. 오탐이 늘어 기본 꺼짐 (docs/models 평가 참고)
AI_WHISPER_HOTWORDS=0
# 음성 등록(FD-016) 최소 말소리 길이(초)와 최소 음량(dBFS). 미달이면 재녹음 안내(422)
AI_ENROLL_MIN_SPEECH_SEC=8
AI_ENROLL_MIN_DBFS=-40
# YAMNet 위험 클래스 임계값 (SDS FD-015 초기값)
AI_YAMNET_THRESHOLD=0.3
# YAMNet 클립 점수 = 클래스별 상위 k개 프레임 평균 (프레임 간격 0.48초)
AI_YAMNET_TOP_K=2
# 모델 가중치 캐시 폴더 (비우면 저장소의 models/, Git 제외)
AI_MODEL_CACHE_DIR=
# /analyze/pcm 기본 샘플레이트 (워치: 16kHz mono 16bit)
AI_PCM_SAMPLE_RATE=16000
# 요청 본문 최대 크기(MB). 넘으면 413 (백엔드 미디어 업로드 제한과 동일)
AI_MAX_UPLOAD_MB=10
# 설정하면 /analyze 호출에 X-API-Key 헤더 필요 (백엔드만 호출, NFR-SEC-03)
AI_API_KEY=
